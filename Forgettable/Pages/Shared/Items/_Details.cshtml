@model Item
@inject Forgettable.Services.PaperlessClient Paperless

<div class="d-flex gap-3">
    <div class="item-details flex-grow-1">
        <div class="d-flex gap-2 mb-2">
            <a asp-page="/Edit" asp-route-id="@Model.ItemId" class="btn btn-sm btn-outline-primary">Edit</a>
            <a asp-page="/Delete" asp-route-id="@Model.ItemId" class="btn btn-sm btn-outline-danger">Delete</a>
        </div>
        <dl class="row mb-0">
            <dt class="col-sm-3">Type</dt>
            <dd class="col-sm-9">@ItemTypes.GetDisplayName(Model.GetType())</dd>
            <dt class="col-sm-3">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>
            <dt class="col-sm-3">Expiry Date</dt>
            <dd class="col-sm-9">@Model.ExpiryDate.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-3">Due Date</dt>
            <dd class="col-sm-9">@Model.DueDate.ToString("dd MMM yyyy")</dd>
            <dt class="col-sm-3">Booked</dt>
            <dd class="col-sm-9"><partial name="_YesNo" model="Model.Booked" /></dd>
            <dt class="col-sm-3">Auto Renew</dt>
            <dd class="col-sm-9"><partial name="_YesNo" model="Model.AutoRenew" /></dd>
        </dl>
        <partial name="Items/Details/_@(Model.GetType().Name)" model="Model" />
    </div>
    @if (Model.PaperlessDocumentIds.Count > 0)
    {
        <div class="document-thumbnails d-flex flex-shrink-0 align-items-start gap-2">
            @foreach (int documentId in Model.PaperlessDocumentIds)
            {
                <a href="@Paperless.GetDocumentUrl(documentId)" target="_blank" rel="noopener">
                    <img src="/paperless/thumbnail/@documentId" alt="Paperless document @documentId" class="img-thumbnail document-thumbnail" loading="lazy" />
                </a>
            }
        </div>
    }
</div>