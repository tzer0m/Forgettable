@model Item
@inject Forgettable.Services.PaperlessClient Paperless

<div class="d-flex gap-3">
    <div class="item-details flex-grow-1">
        <div class="d-flex flex-wrap gap-2 mb-2">
            @if (Model.PaperlessDocumentId is int buttonDocumentId)
            {
                <a href="@Paperless.GetDocumentUrl(buttonDocumentId)" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary d-sm-none">Paperless</a>
            }
            <a asp-page="/Edit" asp-route-id="@Model.ItemId" class="btn btn-sm btn-outline-primary">Edit</a>
            <form method="post" asp-page="/Index" asp-page-handler="Archive" asp-route-id="@Model.ItemId">
                <button type="submit" class="btn btn-sm btn-outline-secondary">@(Model.Archived ? "Unarchive" : "Archive")</button>
            </form>
            <a asp-page="/Delete" asp-route-id="@Model.ItemId" class="btn btn-sm btn-outline-danger">Delete</a>
        </div>
        <dl class="row mb-0">
            <dt class="col-5 col-sm-3">Type</dt>
            <dd class="col-7 col-sm-9">@ItemTypes.GetDisplayName(Model.GetType())</dd>
            <dt class="col-5 col-sm-3">Subject</dt>
            <dd class="col-7 col-sm-9">@Model.Subject</dd>
            <dt class="col-5 col-sm-3">Due Date</dt>
            <dd class="col-7 col-sm-9">@Model.DueDate.ToString("dd MMM yyyy")</dd>
            @if (Model.ExpiryDate != Model.DueDate)
            {
                <dt class="col-5 col-sm-3">Expiry Date</dt>
                <dd class="col-7 col-sm-9"><span class="hover-help" title="@Model.DueDateReason">@Model.ExpiryDate.ToString("dd MMM yyyy")</span></dd>
            }
            <dt class="col-5 col-sm-3">Booked</dt>
            <dd class="col-7 col-sm-9"><partial name="_YesNo" model="Model.Booked" /></dd>
            <dt class="col-5 col-sm-3">Auto Renew</dt>
            <dd class="col-7 col-sm-9"><partial name="_YesNo" model="Model.AutoRenew" /></dd>
        </dl>
        <partial name="Items/Details/_@(Model.GetType().Name)" model="Model" />
    </div>
    @if (Model.PaperlessDocumentId is int documentId)
    {
        <a href="@Paperless.GetDocumentUrl(documentId)" target="_blank" rel="noopener" class="flex-shrink-0 d-none d-sm-block">
            <img src="/paperless/thumbnail/@documentId" alt="Paperless document @documentId" class="img-thumbnail document-thumbnail" loading="lazy" />
        </a>
    }
</div>