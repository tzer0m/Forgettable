@model HomeInsurance

<dl class="row mb-0">
    <dt class="col-5 col-sm-3">Provider</dt>
    <dd class="col-7 col-sm-9">@Model.Provider</dd>
    <dt class="col-5 col-sm-3">Policy Number</dt>
    <dd class="col-7 col-sm-9">@Model.PolicyNumber</dd>
    <dt class="col-5 col-sm-3">Shop Around From</dt>
    <dd class="col-7 col-sm-9">@Model.ShopAroundDate.ToString("dd MMM yyyy")</dd>
</dl>