@model CorporationTax

<div class="row mb-3">
    <label asp-for="CompanyNumber" class="col-sm-3 col-form-label"></label>
    <div class="col-sm-9">
        <input asp-for="CompanyNumber" class="form-control" />
        <span asp-validation-for="CompanyNumber" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <label asp-for="AccountingPeriod" class="col-sm-3 col-form-label"></label>
    <div class="col-sm-9">
        <input asp-for="AccountingPeriod" class="form-control" />
        <span asp-validation-for="AccountingPeriod" class="text-danger"></span>
    </div>
</div>