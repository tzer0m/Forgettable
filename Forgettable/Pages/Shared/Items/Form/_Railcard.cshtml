@model Railcard

<div class="row mb-3">
    <label asp-for="RailcardType" class="col-sm-3 col-form-label"></label>
    <div class="col-sm-9">
        <input asp-for="RailcardType" class="form-control" />
        <span asp-validation-for="RailcardType" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <label asp-for="RailcardNumber" class="col-sm-3 col-form-label"></label>
    <div class="col-sm-9">
        <input asp-for="RailcardNumber" class="form-control" />
        <span asp-validation-for="RailcardNumber" class="text-danger"></span>
    </div>
</div>