@model EnergyTariff

<div class="row mb-3">
    <label asp-for="Supplier" class="col-sm-3 col-form-label"></label>
    <div class="col-sm-9">
        <input asp-for="Supplier" class="form-control" />
        <span asp-validation-for="Supplier" class="text-danger"></span>
    </div>
</div>
<div class="row mb-3">
    <label asp-for="AccountNumber" class="col-sm-3 col-form-label"></label>
    <div class="col-sm-9">
        <input asp-for="AccountNumber" class="form-control" />
        <span asp-validation-for="AccountNumber" class="text-danger"></span>
    </div>
</div>