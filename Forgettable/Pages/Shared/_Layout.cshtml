@inject Microsoft.Extensions.Options.IOptions<Forgettable.Services.CalendarOptions> CalendarSettings
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Forgettable</title>
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="icon" href="~/icon.png" type="image/png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <meta name="theme-color" content="#121b23" />
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar site-header mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-page="/Index">
                    <img src="~/logo.png" alt="" class="site-logo" width="23" height="36" asp-append-version="true" />
                    Forgettable
                </a>
                <div class="d-flex gap-2">
                    <div class="dropdown">
                        <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Add</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            @foreach (IGrouping<Category, Type> group in ItemTypes.All.Values.GroupBy(ItemTypes.GetCategory).OrderBy(x => x.Key))
                            {
                                <li><h6 class="dropdown-header"><span class="badge category-@group.Key.ToString().ToLower()">@group.Key</span></h6></li>
                                @foreach (Type itemType in group)
                                {
                                    <li><a class="dropdown-item" asp-page="/Add" asp-route-type="@itemType.Name">@ItemTypes.GetDisplayName(itemType)</a></li>
                                }
                            }
                        </ul>
                    </div>
                    @if (!string.IsNullOrEmpty(CalendarSettings.Value.Token))
                    {
                        <button type="button" class="btn btn-outline-primary" data-calendar-url="/calendar/@(CalendarSettings.Value.Token).ics" onclick="copyCalendarLink(this)">Calendar</button>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Copy the calendar feed's full address so it can be pasted into a calendar app.
        function copyCalendarLink(button) {
            navigator.clipboard.writeText(new URL(button.dataset.calendarUrl, location.origin).href).then(() => {
                button.textContent = 'Copied';
                setTimeout(() => button.textContent = 'Calendar', 2000);
            });
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>