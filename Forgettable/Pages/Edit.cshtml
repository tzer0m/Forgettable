@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = $"Edit {Model.TypeName}";
}

<h3 class="mb-3">Edit @Model.TypeName</h3>
<form method="post" class="col-lg-8">
    <partial name="Items/_Form" for="Item" />
    <div class="row">
        <div class="col-sm-9 offset-sm-3">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-page="/Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}