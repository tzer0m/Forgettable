@page "{id:int}"
@model DeleteModel
@{
    ViewData["Title"] = $"Delete {Model.TypeName}";
}

<h1>Delete @Model.TypeName</h1>
<p>Are you sure you want to delete the @Model.TypeName for <strong>@Model.Item.Subject</strong>?</p>
<form method="post">
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="/Index" class="btn btn-outline-secondary">Cancel</a>
</form>