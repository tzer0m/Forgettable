@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<table class="table">
    <thead>
        <tr>
            <th class="d-none d-md-table-cell">Category</th>
            <th>Type</th>
            <th>Subject</th>
            <th class="d-none d-sm-table-cell">Due</th>
            <th>Time Left</th>
            <th class="d-none d-md-table-cell">Booked</th>
            <th class="d-none d-md-table-cell">Auto Renew</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Item item in Model.Items)
        {
            <tr role="button" class="@(item.Archived ? "archived" : null)" data-bs-toggle="collapse" data-bs-target="#details-@item.ItemId" aria-expanded="false" aria-controls="details-@item.ItemId">
                <td class="d-none d-md-table-cell"><span class="badge category-@item.Category.ToString().ToLower()">@item.Category</span></td>
                <td><span class="category-dot category-@item.Category.ToString().ToLower() d-md-none" title="@item.Category"></span>@ItemTypes.GetDisplayName(item.GetType())</td>
                <td>@item.Subject</td>
                <td class="d-none d-sm-table-cell">@item.DueDate.ToString("dd MMM yyyy")</td>
                <td>@(item.Archived ? null : TimeLeft.Describe(item.DueDate))</td>
                <td class="d-none d-md-table-cell">@if (!item.Archived) { <partial name="_YesNo" model="item.Booked" /> }</td>
                <td class="d-none d-md-table-cell">@if (!item.Archived) { <partial name="_YesNo" model="item.AutoRenew" /> }</td>
            </tr>
            <tr class="collapse" id="details-@item.ItemId">
                <td colspan="7">
                    <partial name="Items/_Details" model="item" />
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        // Size each open item's thumbnails to the height of its details column. Resizing the thumbnail changes the
        // width left for the details, which can rewrap them, so repeat until the height settles.
        function sizeThumbnails(pane) {
            const details = pane.querySelector('.item-details');
            for (let attempt = 0; attempt < 3; attempt++) {
                const height = details.offsetHeight;
                pane.querySelectorAll('.document-thumbnail').forEach(image => image.style.height = `${height}px`);
                if (details.offsetHeight === height) {
                    break;
                }
            }
        }
        document.addEventListener('show.bs.collapse', event => { if (event.target.matches('tr')) { requestAnimationFrame(() => sizeThumbnails(event.target)); } });
        document.addEventListener('load', event => { if (event.target.matches?.('.document-thumbnail')) { sizeThumbnails(event.target.closest('tr')); } }, true);
        window.addEventListener('resize', () => document.querySelectorAll('tr.collapse.show').forEach(sizeThumbnails));
    </script>
}