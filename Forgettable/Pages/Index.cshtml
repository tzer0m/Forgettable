@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<table class="table">
    <thead>
        <tr>
            <th>Category</th>
            <th>Type</th>
            <th>Subject</th>
            <th>Due</th>
            <th>Time Left</th>
            <th>Booked</th>
            <th>Auto Renew</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Item item in Model.Items)
        {
            <tr role="button" class="@(item.Archived ? "archived" : null)" data-bs-toggle="collapse" data-bs-target="#details-@item.ItemId" aria-expanded="false" aria-controls="details-@item.ItemId">
                <td><span class="badge category-@item.Category.ToString().ToLower()">@item.Category</span></td>
                <td>@ItemTypes.GetDisplayName(item.GetType())</td>
                <td>@item.Subject</td>
                <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                <td>@(item.Archived ? null : TimeLeft.Describe(item.DueDate))</td>
                <td>@if (!item.Archived) { <partial name="_YesNo" model="item.Booked" /> }</td>
                <td>@if (!item.Archived) { <partial name="_YesNo" model="item.AutoRenew" /> }</td>
            </tr>
            <tr class="collapse" id="details-@item.ItemId">
                <td colspan="7">
                    <partial name="Items/_Details" model="item" />
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        // Size each open item's thumbnails to the height of its details column.
        function sizeThumbnails(pane) {
            const details = pane.querySelector('.item-details');
            pane.querySelectorAll('.document-thumbnail').forEach(image => image.style.height = `${details.offsetHeight}px`);
        }
        document.addEventListener('show.bs.collapse', event => { if (event.target.matches('tr')) { requestAnimationFrame(() => sizeThumbnails(event.target)); } });
        window.addEventListener('resize', () => document.querySelectorAll('tr.collapse.show').forEach(sizeThumbnails));
    </script>
}