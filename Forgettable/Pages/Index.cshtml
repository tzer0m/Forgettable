@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    DateOnly today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Dashboard</h1>
    <div class="dropdown">
        <button class="btn btn-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">Add</button>
        <ul class="dropdown-menu dropdown-menu-end">
            @foreach (KeyValuePair<string, Type> itemType in ItemTypes.All)
            {
                <li><a class="dropdown-item" asp-page="/Add" asp-route-type="@itemType.Key">@ItemTypes.GetDisplayName(itemType.Value)</a></li>
            }
        </ul>
    </div>
</div>
<table class="table">
    <thead>
        <tr>
            <th>Type</th>
            <th>Subject</th>
            <th>Due</th>
            <th>Days Left</th>
            <th>Booked</th>
            <th>Auto Renew</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Item item in Model.Items)
        {
            <tr role="button" data-bs-toggle="collapse" data-bs-target="#details-@item.ItemId" aria-expanded="false" aria-controls="details-@item.ItemId">
                <td>@ItemTypes.GetDisplayName(item.GetType())</td>
                <td>@item.Subject</td>
                <td>@item.DueDate.ToString("dd MMM yyyy")</td>
                <td>@(item.DueDate.DayNumber - today.DayNumber)</td>
                <td><partial name="_YesNo" model="item.Booked" /></td>
                <td><partial name="_YesNo" model="item.AutoRenew" /></td>
            </tr>
            <tr class="collapse" id="details-@item.ItemId">
                <td colspan="6">
                    <partial name="Items/_Details" model="item" />
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>
        // Size each open item's thumbnails to the height of its details column.
        function sizeThumbnails(pane) {
            const details = pane.querySelector('.item-details');
            pane.querySelectorAll('.document-thumbnail').forEach(image => image.style.height = `${details.offsetHeight}px`);
        }
        document.addEventListener('shown.bs.collapse', event => { if (event.target.matches('tr')) { sizeThumbnails(event.target); } });
        window.addEventListener('resize', () => document.querySelectorAll('tr.collapse.show').forEach(sizeThumbnails));
    </script>
}