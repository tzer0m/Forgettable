@page "{type}"
@model AddModel
@{
    ViewData["Title"] = $"Add {Model.TypeName}";
}

<h1>Add @Model.TypeName</h1>
<form method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Item.Name" class="form-label"></label>
        <input asp-for="Item.Name" class="form-control" />
        <span asp-validation-for="Item.Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Item.ExpiryDate" class="form-label"></label>
        <input asp-for="Item.ExpiryDate" type="date" class="form-control" />
        <span asp-validation-for="Item.ExpiryDate" class="text-danger"></span>
    </div>
    <partial name="Items/Add/_@(Model.Item.GetType().Name)" for="Item" />
    <div class="form-check mb-3">
        <input asp-for="Item.AutoRenew" class="form-check-input" />
        <label asp-for="Item.AutoRenew" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="/Index" class="btn btn-outline-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}